            <?php if ($result && $currentQuestion): ?>
                <div class="practice-result <?= $result['is_correct'] ? 'is-correct' : 'is-improve' ?>">
                    <div><strong><?= $result['is_correct'] ? '✅ Correct Answer' : '💡 Practice Feedback' ?></strong><p><?= e($result['feedback']) ?></p></div>
                    <div><span><?= ($result['ai_status'] ?? '') === 'success' ? 'AI Corrected / Natural Answer' : 'Correct / Natural Answer' ?></span><h3><?= e(($result['natural_answer'] ?? '') ?: $result['sample_answer']) ?></h3><p><?= e($result['explanation']) ?></p><?php if (!empty($result['ai_feedback'])): ?><div class="ai-feedback-box"><?= nl2br(e($result['ai_feedback'])) ?></div><?php elseif (($result['ai_status'] ?? '') === 'fallback'): ?><div class="ai-feedback-box muted">AI enhancement is currently unavailable, so local practice feedback is shown safely.</div><?php endif; ?><small><?= e($result['next_step']) ?></small></div>
                </div>
                <br>
            <?php endif; ?>
            <div class="practice-question-grid">
                <?php foreach ($questions as $q): ?>
                    <form class="practice-question-card" method="post">
