<script>
document.querySelectorAll('.voice-btn').forEach(function(button){
    button.addEventListener('click', function(){
        var SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        var textarea = button.closest('form').querySelector('textarea');
        if (!SpeechRecognition) { alert('Voice practice works best in Chrome browser. Please type your answer here.'); return; }
        var recognition = new SpeechRecognition();
        recognition.lang = 'en-IN';
        recognition.interimResults = false;
        button.textContent = '🎙 Listening...';
        recognition.onresult = function(event){ textarea.value = event.results[0][0].transcript; button.textContent = '🎤 Start Speaking'; };
        recognition.onerror = function(){ button.textContent = '🎤 Start Speaking'; alert('Could not hear clearly. Please try again or type your answer.'); };
        recognition.onend = function(){ button.textContent = '🎤 Start Speaking'; };
        recognition.start();
    });
});
</script>
