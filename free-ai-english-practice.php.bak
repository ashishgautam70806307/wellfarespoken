<?php
require_once __DIR__ . '/includes/functions.php';
ensure_core_schema_columns();
material_ensure_schema();
$quickToolResult = null;
$quickToolInput = '';
$quickToolMode = 'sentence_correction';
$page_title = app_setting('seo_practice_title', 'Free AI English Practice Lab');
$meta_description = app_setting('seo_practice_description', 'Practise English tenses, speaking situations and sentence correction for free.');
ensure_schema_updates();
$lessonId = isset($_GET['lesson']) ? (int)$_GET['lesson'] : 0;
$lesson = $lessonId ? fetch_practice_lesson($lessonId) : null;
$questions = $lesson ? fetch_practice_questions((int)$lesson['id'], 12) : [];
$result = null;
$currentQuestion = null;
if ($_SERVER['REQUEST_METHOD'] === 'POST' && !isset($_POST['quick_practice']) && csrf_validate($_POST['csrf_token'] ?? '')) {
    $questionId = (int)($_POST['question_id'] ?? 0);
    $answer = trim($_POST['answer'] ?? '');
    $stmt = db()->prepare("SELECT * FROM practice_questions WHERE id = ? AND published='Yes' AND status_deleted=0 LIMIT 1");
    $stmt->execute([$questionId]);
    $currentQuestion = $stmt->fetch();
    if ($currentQuestion && $answer !== '') {
        $localResult = evaluate_practice_answer($currentQuestion, $answer);
        $aiResult = practice_ai_feedback($currentQuestion, $answer, $localResult);
        $result = merge_ai_practice_result($localResult, $aiResult);
        save_practice_attempt($questionId, $answer, $result);
        $lesson = fetch_practice_lesson((int)$currentQuestion['lesson_id']);
        $questions = $lesson ? fetch_practice_questions((int)$lesson['id'], 12) : [];
    } else {
        flash('error', 'Please write or speak your answer first.');
    }
}
$categories = fetch_practice_categories();
$summary = practice_attempt_summary();
$practiceHero = fetch_hero_banner('practice');
require_once __DIR__ . '/includes/header.php';
?>
