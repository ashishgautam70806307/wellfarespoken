# Production configuration
APP_ENV=production
APP_DEBUG=false
# true = load Manrope and Noto Sans Devanagari from Google Fonts; false = use the system-font fallback
APP_REMOTE_FONTS=true
APP_URL=https://your-domain.com
APP_NAME="Well Fare English Spoken"
APP_TAGLINE="Speak English With Confidence"
APP_PHONE="+91 9506617831"
APP_WHATSAPP=919506617831
APP_EMAIL=info@your-domain.com
APP_ADDRESS="Station Road, Mariahu, Jaunpur, Uttar Pradesh"

DB_HOST=localhost
DB_PORT=3306
DB_NAME=wellfare_english
DB_USER=change_me
DB_PASS="change_me"

SESSION_NAME=wellfare_session
SESSION_SECURE_COOKIE=true
SESSION_SAMESITE=Lax
TRUST_PROXY_HEADERS=false

# Keep true only for the first System Check after this upgrade.
# After all checks are green, change it to false.
APP_ALLOW_SCHEMA_UPDATES=true

# Hidden until the institute enables the reviewed AI Teacher module
APP_AI_TEACHER_ENABLED=false
