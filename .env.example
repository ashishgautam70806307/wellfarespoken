# Application
# APP_RUNTIME_MODE=auto detects local/live. Set local or live only if hosting detection needs an explicit override.
APP_RUNTIME_MODE=auto
# APP_ENV may be omitted. The project detects local/live automatically.
APP_DEBUG=false
APP_REMOTE_FONTS=true
APP_URL=
APP_NAME="Well Fare English Spoken"
APP_TAGLINE="Speak English With Confidence"
APP_PHONE="+91 9506617831"
APP_WHATSAPP=919506617831
APP_EMAIL=wellfareenglishspoken@gmail.com
APP_ADDRESS="Station Road, Mariahu, Jaunpur, Uttar Pradesh"

# Database connection
# auto: localhost/127.0.0.1/::1 uses DB_LOCAL_*; any other host uses DB_LIVE_*.
# manual: DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASS are used.
DB_CONNECTION_MODE=auto

DB_LOCAL_HOST=localhost
DB_LOCAL_PORT=3306
DB_LOCAL_NAME=wellfare_english
DB_LOCAL_USER=root
DB_LOCAL_PASS=

DB_LIVE_HOST=localhost
DB_LIVE_PORT=3306
DB_LIVE_NAME=u790281974_wellfarespoken
DB_LIVE_USER=u790281974_wellfarespoken
# DB_LIVE_PASS may be set here to override the configured live fallback.

# Generic DB_* values are read only when DB_CONNECTION_MODE=manual.
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=wellfare_english
# DB_USER=root
# DB_PASS=

SESSION_NAME=wellfare_session
# Omit SESSION_SECURE_COOKIE for automatic HTTPS detection.
SESSION_SAMESITE=Lax
TRUST_PROXY_HEADERS=false

# Keep false during normal use. Import sql/wellfare_english_complete.sql instead.
APP_ALLOW_SCHEMA_UPDATES=false
APP_AI_TEACHER_ENABLED=false
